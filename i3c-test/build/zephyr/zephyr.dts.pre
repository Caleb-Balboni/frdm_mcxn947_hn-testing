/ {
 soc {
  #address-cells = <1>;
  #size-cells = <1>;
  compatible = "simple-bus";
  interrupt-parent = <&nvic>;
  ranges;

  nvic: interrupt-controller@e000e100 {
   #address-cells = <1>;
   compatible = "arm,v8m-nvic";
   reg = <0xe000e100 0xc00>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  systick: timer@e000e010 {
   compatible = "arm,armv8m-systick";
   reg = <0xe000e010 0x10>;
  };
 };
};
# 9 "/home/bionet-caleb/testing/zephyr-testing/zephyr/dts/arm/nxp/nxp_mcxn94x.dtsi" 2 3 4

/ {
 soc {
  sram: sram@14000000 {
   ranges = <0x4000000 0x14000000 0x20000000>;
  };

  peripheral: peripheral@50000000 {
   ranges = <0x0 0x50000000 0x10000000>;

   ftfe: flash-controller@43000 {
    ranges = <0x0 0x10000000 0x4000000>;
   };
  };

  flexspi: spi@500c8000 {
   reg = <0x500c8000 0x1000>, <0x90000000 (((8) * 1024) * 1024)>;
  };
 };
};

