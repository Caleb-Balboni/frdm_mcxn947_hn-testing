&i3c1 {
 pinctrl-0 = <&pinmux_i3c1>;
 pinctrl-names = "default";
};

&flexcan0 {
 pinctrl-0 = <&pinmux_flexcan0>;
 pinctrl-names = "default";
};

&sc_timer {
 pinctrl-0 = <&pinmux_sctimer>;
 pinctrl-names = "default";
};

dvp_20pin_i2c: &flexcomm7_lpi2c7 {};

dvp_20pin_interface: &video_sdma {};
