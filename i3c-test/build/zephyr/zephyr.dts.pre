/ {
 aliases {
  led0 = &red_led;
  led1 = &green_led;
  led2 = &blue_led;
  sw0 = &user_button_2;
  sw1 = &user_button_3;
  sdhc0 = &usdhc0;
  mcuboot-button0 = &user_button_2;
 };

 chosen {
  zephyr,edac = &erm0;
 };

 leds {
  compatible = "gpio-leds";

  green_led: led_1 {
   gpios = <&gpio0 27 (1 << 0)>;
   label = "Green LED";
   status = "disabled";
  };

  blue_led: led_2 {
   gpios = <&gpio1 2 (1 << 0)>;
   label = "Blue LED";
   status = "disabled";
  };

  red_led: led_3 {
   gpios = <&gpio0 10 (1 << 0)>;
   label = "Red LED";
   status = "disabled";
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button_2: button_0 {
   label = "User SW2";
   gpios = <&gpio0 23 ((1 << 0) | (1 << 4))>;
   zephyr,code = <11>;
   status = "disabled";
  };

  user_button_3: button_1 {
   label = "User SW3";
   gpios = <&gpio0 6 ((1 << 0) | (1 << 4))>;
   zephyr,code = <2>;
   status = "disabled";
  };
 };

 hydronet_gpio_header: hydronet_gpio_connector {
  compatible = "hydronet-header";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <1 0 &gpio3 18 0>,
      <2 0 &gpio3 19 0>,
      <3 0 &gpio3 20 0>,
      <4 0 &gpio3 21 0>,
      <5 0 &gpio3 22 0>,
      <6 0 &gpio3 23 0>,
      <7 0 &gpio5 3 0>,
      <8 0 &gpio5 4 0>,
      <9 0 &gpio5 5 0>,
      <10 0 &gpio5 6 0>,
             <11 0 &gpio5 7 0>,
      <12 0 &gpio5 8 0>,
      <13 0 &gpio5 9 0>,
      <14 0 &gpio4 4 0>,
      <15 0 &gpio4 5 0>,
      <16 0 &gpio4 6 0>,
      <17 0 &gpio4 7 0>,
      <18 0 &gpio4 14 0>,
      <19 0 &gpio4 18 0>,
      <20 0 &gpio4 22 0>,
      <21 0 &gpio0 4 0>,
             <22 0 &gpio0 5 0>;

 };

 mikrobus_header: mikrobus-connector {
  compatible = "mikro-bus";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map =
      <1 0 &gpio1 3 0>,
      <2 0 &gpio3 23 0>,
      <3 0 &gpio3 21 0>,
      <4 0 &gpio3 22 0>,
      <5 0 &gpio3 20 0>,
      <6 0 &gpio3 19 0>,
      <7 0 &gpio5 7 0>,
      <8 0 &gpio1 16 0>,
      <9 0 &gpio1 17 0>,
      <10 0 &gpio1 1 0>,
      <11 0 &gpio1 0 0>;
 };

 arduino_header: arduino-connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <2 0 &gpio0 14 0>,
      <3 0 &gpio0 22 0>,
      <4 0 &gpio0 15 0>,
      <5 0 &gpio0 23 0>,
      <6 0 &gpio4 3 0>,
      <7 0 &gpio4 2 0>,
      <8 0 &gpio0 29 0>,
      <9 0 &gpio1 23 0>,
      <10 0 &gpio0 30 0>,
      <11 0 &gpio1 21 0>,
      <12 0 &gpio1 2 0>,
      <13 0 &gpio0 31 0>,
      <14 0 &gpio0 28 0>,
      <15 0 &gpio0 10 0>,
      <16 0 &gpio0 27 0>,
      <17 0 &gpio0 24 0>,
      <18 0 &gpio0 26 0>,
      <19 0 &gpio0 25 0>,
      <20 0 &gpio4 0 0>,
      <21 0 &gpio4 1 0>;
 };




 nxp_lcd_8080_connector: lcd-8080-connector {
  compatible = "nxp,lcd-8080";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <9 0 &gpio4 6 0>,
      <10 0 &gpio4 5 0>,
      <11 0 &gpio4 7 0>;
 };

 dvp_20pin_connector: dvp-20pin-connector {
  compatible = "arducam,dvp-20pin-connector";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0x0 0x7F>;
  gpio-map = <17 0 &gpio1 19 0>,
      <18 0 &gpio1 18 0>;
 };
};

