  reg = <0x20000000 ((416) * 1024)>;
 };
};

&peripheral {
 #address-cells = <1>;
 #size-cells = <1>;

 syscon: syscon@0 {
  compatible = "nxp,lpc-syscon";
  reg = <0x0 0x4000>;
  #clock-cells = <1>;

  reset: reset {
   compatible = "nxp,lpc-syscon-reset";
   #reset-cells = <1>;
  };
 };

